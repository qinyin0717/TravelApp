<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限声明 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelApp"
        tools:targetApi="31">

        <!-- 启动主界面 -->
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 聊天机器人页面 -->
        <activity android:name=".ChatbotActivity" android:exported="false" />

        <!-- 设置、资料相关页面 -->
        <activity android:name=".Setting.SettingActivity"/>
        <activity android:name=".Setting.ProfileActivity"/>
        <activity android:name=".Setting.EditProfileActivity"/>

        <!-- 发帖相关页面 -->
        <activity android:name=".Post.PostActivity"/>

        <!-- 旅游指南相关页面 -->
        <activity android:name=".TravelGuide.TravelGuideActivity" />
        <activity android:name=".TravelGuide.RecommendationDetailActivity" />

    </application>

</manifest>
