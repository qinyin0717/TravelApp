<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Collapsed header (click to expand composer) -->
    <LinearLayout
        android:id="@+id/headerCollapsed"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- User profile icon -->
        <ImageView
            android:id="@+id/imageViewCurrentProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_profile_test"/>

        <!-- Prompt text -->
        <TextView
            android:layout_marginStart="12dp"
            android:text="Share your traveling story"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Expanded composer for post creation (initially hidden) -->
    <LinearLayout
        android:id="@+id/composerExpanded"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- User info section -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Composer profile picture -->
            <ImageView
                android:id="@+id/imageViewComposerProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_profile_test"/>

            <!-- Composer username -->
            <TextView
                android:id="@+id/textViewComposerName"
                android:layout_marginStart="12dp"
                android:text="Test User"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Text input field for post content -->
        <EditText
            android:id="@+id/editTextPost"
            android:hint="Share your Travel Story!"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Row of action buttons (Tag, Upload, Location) -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/buttonTagPeople"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tag People"/>

            <Button
                android:id="@+id/buttonSelectMedia"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Upload Image/Video"/>

            <Button
                android:id="@+id/buttonAddLocation"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Add Location"/>
        </LinearLayout>

        <!-- Location spinners (hidden initially) -->
        <LinearLayout
            android:id="@+id/locationContainer"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- State label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="State:"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- State dropdown -->
            <Spinner
                android:id="@+id/spinnerState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/prompt_select_state"/>

            <!-- City label -->
            <TextView
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City:"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- City dropdown -->
            <Spinner
                android:id="@+id/spinnerCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/prompt_select_city"/>
        </LinearLayout>

        <!-- Posting status text -->
        <TextView
            android:id="@+id/textPostingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your post is in progress"
            android:visibility="gone"
            android:textStyle="italic"
            android:layout_marginTop="8dp"/>

        <!-- Indeterminate progress bar -->
        <ProgressBar
            android:id="@+id/progressPosting"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"/>

        <!-- Status icon and message (e.g. success/failure) -->
        <LinearLayout
            android:id="@+id/statusContainer"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageStatusIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:id="@+id/textStatusMessage"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Display tagged users (if any) -->
        <TextView
            android:id="@+id/textViewTagged"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/holo_blue_dark"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

        <!-- Submit post button -->
        <Button
            android:id="@+id/buttonPost"
            android:text="Post"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- RecyclerView to show all posts in feed -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPosts"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
