<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_go_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Settings" />

    <Button
        android:id="@+id/btn_go_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Profile"
        android:layout_marginTop="16dp" />

    <!-- 新增按钮：打开Travel Guide -->
    <Button
        android:id="@+id/btn_go_travel_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Travel Guide"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_go_post_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Post Page"
        android:layout_marginTop="16dp" />

</LinearLayout>
