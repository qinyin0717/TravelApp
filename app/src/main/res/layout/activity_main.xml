<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/wallpaper">  <!-- Set custom background wallpaper -->

    <!-- App title at the top -->
    <TextView
        android:id="@+id/slogan_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JovaGo"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <!-- Subtitle tagline below the title -->
    <TextView
        android:id="@+id/slogan_text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Where Journeys Begin"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@+id/slogan_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <!-- Travel Guide button -->
    <Button
        style="@style/AppButtonStyle"
        android:id="@+id/btn_go_travel_guide"
        android:text="Travel Rating"
        app:layout_constraintTop_toBottomOf="@+id/slogan_text2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <!-- Chatbot feature button -->
    <Button
        style="@style/AppButtonStyle"
        android:id="@+id/btn_go_AI_Box"
        android:text="JovaGo Chatbot"
        app:layout_constraintTop_toBottomOf="@+id/btn_go_travel_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Posts page button -->
    <Button
        style="@style/AppButtonStyle"
        android:id="@+id/btn_go_post_page"
        android:text="Posts"
        app:layout_constraintTop_toBottomOf="@+id/btn_go_AI_Box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- User profile button -->
    <Button
        style="@style/AppButtonStyle"
        android:id="@+id/btn_go_profile"
        android:text="Profile"
        app:layout_constraintTop_toBottomOf="@+id/btn_go_post_page"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Settings page button -->
    <Button
        style="@style/AppButtonStyle"
        android:id="@+id/btn_go_settings"
        android:text="Settings"
        app:layout_constraintTop_toBottomOf="@+id/btn_go_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Exit button -->
    <Button
        style="@style/AppButtonStyle"
        android:id="@+id/btn_Exit"
        android:text="Exit"
        app:layout_constraintTop_toBottomOf="@+id/btn_go_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
